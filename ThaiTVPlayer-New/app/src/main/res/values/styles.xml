<resources>
<style name="AppButtonStyle" parent="android:style/Widget.Material.Button">
    <item name="android:background">@drawable/bg_menu_button</item>
    <item name="android:textColor">#F5F5F5</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:minHeight">0dp</item>
    <item name="android:minWidth">0dp</item>
    <item name="android:fontFamily">sans</item>
</style>

<style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:colorAccent">#FF9800</item>
    <item name="android:navigationBarColor">#101010</item>
    <item name="android:statusBarColor">#101010</item>
    <item name="android:buttonStyle">@style/AppButtonStyle</item>
</style>
</resources>
