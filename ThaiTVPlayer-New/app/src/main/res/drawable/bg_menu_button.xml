<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3A2414" />
            <stroke android:width="2dp" android:color="#FFB74D" />
            <corners android:radius="12dp" />
            <padding android:left="6dp" android:top="2dp" android:right="6dp" android:bottom="2dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#242424" />
            <stroke android:width="1dp" android:color="#8A5A25" />
            <corners android:radius="12dp" />
            <padding android:left="6dp" android:top="2dp" android:right="6dp" android:bottom="2dp" />
        </shape>
    </item>
</selector>
